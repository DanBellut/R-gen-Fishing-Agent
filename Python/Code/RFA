MONATE = ["Januar", "Februar", "März", "April", "Mai", "Juni", "Juli",
          "August", "September", "Oktober", "November", "Dezember"]

JA = {"ja", "j", "jo", "jep", "klar", "gerne", "yes", "y"}
NEIN = {"nein", "n", "ne", "nee", "no"}
ENDE = {"ende", "exit", "quit", "q", "tschüss"}


def normalisiere(text):
    """Kleinschreibung, ohne Leerzeichen am Rand, Umlaut-Umschreibung vereinheitlicht."""
    return text.strip().lower().replace("ae", "ä").replace("oe", "ö").replace("ue", "ü")


def finde_monat(eingabe):
    """Gibt den Monatsnamen zurück (auch bei Eingabe als Zahl 1–12) oder None."""
    eingabe = normalisiere(eingabe)
    if eingabe.isdigit() and 1 <= int(eingabe) <= 12:
        return MONATE[int(eingabe) - 1]
    for monat in MONATE:
        if eingabe == monat.lower():
            return monat
    return None


def frage_ja_nein(frage):
    """Fragt so lange nach, bis ja oder nein geantwortet wird."""
    while True:
        antwort = normalisiere(input(frage + " "))
        if antwort in JA:
            return True
        if antwort in NEIN:
            return False
        print("Bitte antworte mit ja oder nein.")


def waehle_zielfisch(saison):
    """Lässt den Nutzer zwischen den Zielfischen einer Saison wählen."""
    while True:
        eingabe = normalisiere(input(saison["frage"]))
        for schluessel in saison["fische"]:
            if eingabe in FISCHE[schluessel]["aliase"]:
                return schluessel
        print("Für diesen Zielfisch habe ich keinen Rat. Versuch es nochmal und achte bitte "
              "auf die Schreibweise.")


def berate(monat):
    """Gibt die Empfehlung für einen Monat aus."""
    saison = SAISONS.get(monat)
    if saison is None:
        print(f"Für den {monat} habe ich leider noch keine Empfehlung.")
        return

    if "intro" in saison:
        print(saison["intro"])
    if len(saison["fische"]) > 1:
        schluessel = waehle_zielfisch(saison)
    else:
        schluessel = saison["fische"][0]
    fisch = FISCHE[schluessel]

    print(fisch["intro"].format(monat=monat))
    if frage_ja_nein(f"Willst du wissen, wo die Hotspots für {fisch['name']} in Rügener Gewässern sind?"):
        print(fisch["hotspots"].format(monat=monat))
    if frage_ja_nein(f"Willst du wissen, welche Köder du für {fisch['name']} im {monat} brauchst?"):
        print(fisch["koeder"].format(monat=monat))
    print(fisch.get("abschied", ABSCHIED))


def main():
    print("Willkommen zum Rügen Fishing Agent!")
    print("(Mit 'ende' beendest du das Programm.)")
    while True:
        eingabe = input("Nenne einen Monat, in dem du auf Rügen angeln magst. Ich sage dir dann, "
                        "welcher Zielfisch in dieser Saison gut geeignet ist. ")
        if normalisiere(eingabe) in ENDE:
            break
        monat = finde_monat(eingabe)
        if monat is None:
            print("Diesen Monat kenne ich nicht. Bitte achte auf die Schreibweise, z. B. 'Mai' oder '5'.")
            continue
        berate(monat)
        if not frage_ja_nein("Möchtest du Tipps für einen weiteren Monat?"):
            break
    print("Petri Heil und bis zum nächsten Mal!")


if __name__ == "__main__":
    try:
        main()
    except (KeyboardInterrupt, EOFError):
